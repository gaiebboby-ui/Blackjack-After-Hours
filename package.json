{
  "name": "blackjack-after-hours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "npm run check:artwork && node scripts/prepare-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1",
    "build": "npm run assets && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check:artwork": "node scripts/check-artwork.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "description": "Atmospheric blackjack with an animated dealer, illustrated cards and virtual chips.",
  "engines": {
    "node": ">=22.12.0"
  }
}
